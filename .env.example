# Copy to .env and fill in. Never commit .env.

# Report drafts: template | llm  (llm rewords the template from the numbers only; the template is used on any error)
REPORT_PROVIDER=template

# Any OpenAI-compatible endpoint:
#   Ollama Cloud (Pro):   LLM_BASE_URL=https://ollama.com/v1        key from ollama.com/settings/keys, LLM_MODEL=gpt-oss:120b
#   Ollama local (free):  LLM_BASE_URL=http://localhost:11434/v1   no key, a small model such as qwen2.5:3b
#   Other LLM API:        that provider's base URL + your own key (never the university course key)
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b

# --- API (backend/) ---
# Supabase project URL: login tokens are checked against its public keys
SUPABASE_URL=https://your-project.supabase.co
# Only for older Supabase projects that sign tokens with a shared secret; leave empty otherwise
SUPABASE_JWT_SECRET=
# Supabase Postgres connection string (Project Settings → Database); local dev can use SQLite
DATABASE_URL=sqlite:///./neurolens.db
# Folder with classifier.onnx and segmenter3d.onnx (paths are relative to the repo root, where the API is started)
MODEL_DIR=ml/models
# Where de-identified scans and results are written
STORAGE_DIR=backend/storage
# Dashboard origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000

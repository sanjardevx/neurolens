# Copy to .env and fill in. Never commit .env.

# Report generator: llm | template  (llm falls back to template on any error)
REPORT_PROVIDER=template

# Any OpenAI-compatible endpoint:
#   Ollama local (free):  LLM_BASE_URL=http://localhost:11434/v1   no key
#   Ollama Cloud (Pro):   LLM_BASE_URL=https://ollama.com/v1        key from ollama.com/settings/keys
#   Other LLM API:        that provider's base URL + your own key (never the university course key)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
